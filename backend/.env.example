# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Places & Geocoding API — Geoapify (free, no credit card needed)
# Get your key at: https://myprojects.geoapify.com (3,000 req/day free)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Optional: Google Places API (requires Google Cloud billing enabled)
# GOOGLE_PLACES_API_KEY=your_google_places_key_here

# AI via Google Gemini API (free, no credit card — get key at aistudio.google.com)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=

# OSRM (public demo server — replace with self-hosted in production)
OSRM_BASE_URL=http://router.project-osrm.org

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_string_here
